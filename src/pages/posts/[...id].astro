---
/**
 * 文章页（/posts/<文件名>/）—— 结构逐字复刻原稿 post.html：
 * 阅读进度条（body 首个子元素）→ 面包屑 → 文章头 → 封面 → 目录 → 正文 →
 * 分享 / 作者卡 / 上下篇 + 右侧粘性目录。
 *
 * 目录里每一项的 href 与 render() 给出的 slug 一致（中文标题的 slug 由 Astro 生成），
 * 因此不再是原稿写死的 #section-1..4，但站内跳转仍然全部有效。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/page-post.css';

import { getCollection, render } from 'astro:content';
import Decor from '../../components/Decor.astro';
import Toc from '../../components/Toc.astro';
import type { Post } from '../../lib/posts';
import {
  formatDate,
  formatDateCN,
  neighbours,
  postPath,
  published,
  readingLabel,
  sortPosts,
  tagPath,
} from '../../lib/posts';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = published(await getCollection('posts'));
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = sortPosts(published(await getCollection('posts')));
const { prev, next } = neighbours(all, post);

/** 目录只取 h2 / h3（与 .toc-item--h3 缩进对应） */
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  active="blog"
  ogType="article"
>
  <Fragment slot="prepend">
    <div class="read-progress" role="progressbar" aria-label="阅读进度"></div>
  </Fragment>

  <main>
    <div class="container">
      <div class="article-wrap">
        <article>
          <nav aria-label="面包屑">
            <a class="eyebrow link-underline" href="/blog/">← 返回文章列表</a>
          </nav>

          <header class="post-header">
            <div class="card-meta">
              <a class="card-cat" href={tagPath(post.data.category)}>{post.data.category}</a>
              <span class="card-date">{formatDate(post.data.date)}</span>
            </div>
            <h1 class="post-title">{post.data.title}</h1>
            <div class="post-meta-row">
              <span class="post-date">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" /></svg>
                {formatDateCN(post.data.date)}
              </span>
              <span class="post-read-time">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /></svg>
                {readingLabel(post)}
              </span>
            </div>
            <ul class="tag-list" role="list">
              {post.data.tags.map((tag) => <li><a class="tag" href={tagPath(tag)}>{tag}</a></li>)}
            </ul>
          </header>

          <figure class="post-cover decor-host">
            <div class="card-cover-placeholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" style="width:4rem;height:4rem;opacity:.13"><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M3 9h18M9 21V9" /></svg>
            </div>
            <Decor slot="post-cover-sticker" />
          </figure>

          <Toc items={tocItems} label="目录" title="目录" />

          <div class="prose decor-host">
            <Content />
            <Decor slot="post-body-figure" />
          </div>

          <div class="article-foot">
            <div class="share-row">
              <span class="share-label">分享</span>
              <a class="tag" href="#">复制链接</a>
              <a class="tag" href="#">X / Twitter</a>
              <a class="tag" href="#">微博</a>
            </div>

            <div class="author-card">
              <div class="author-avatar-placeholder" aria-hidden="true">{site.markLetter}</div>
              <div class="author-info">
                <p class="author-name">{site.author.name}</p>
                <p class="author-bio">{site.author.bio}</p>
                <div class="author-links">
                  <a class="author-link" href="/about/">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
                    关于我
                  </a>
                  <a class="author-link" href={site.links.github}>
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" /></svg>
                    GitHub
                  </a>
                </div>
              </div>
            </div>

            <nav class="post-nav" aria-label="文章导航">
              {
                prev && (
                  <a class="post-nav-item" href={postPath(prev)}>
                    <span class="post-nav-dir">← 上一篇</span>
                    <span class="post-nav-title">{prev.data.title}</span>
                  </a>
                )
              }
              {
                next && (
                  <a class="post-nav-item post-nav-item--next" href={postPath(next)}>
                    <span class="post-nav-dir">下一篇 →</span>
                    <span class="post-nav-title">{next.data.title}</span>
                  </a>
                )
              }
            </nav>
          </div>
        </article>

        <aside class="article-aside">
          <Toc items={tocItems} label="页面目录" title="目录" withDecor />
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>