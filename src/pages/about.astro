---
/**
 * 关于页 —— 自我介绍（docs/bio.md）、研究线索、工具栈、兴趣。
 *
 * 版面和文案都换成了真人资料：技能百分比条（本来就没有数据支撑）换成
 * 分组工具 chip，占位项目卡换成兴趣四卡，「文章 N 篇」仍是真实篇数。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/page-about.css';

import { getCollection } from 'astro:content';
import Decor from '../components/Decor.astro';
import { published } from '../lib/posts';
import { site, titled } from '../lib/site';
import { games, identity, interests, intro, personalTags, research, stack } from '../lib/profile';

const postCount = published(await getCollection('posts')).length;

const lead = {
  before: '你好，我是川崎·杭汐，',
  after: '一个学人工智能的学生，也',
  em: '写字',
};

const facts = [
  { label: '现居', value: identity.city },
  { label: '语言', value: identity.languages },
  { label: '专业', value: `${identity.major} · 本科在读` },
  { label: '文章', value: `${postCount} 篇` },
];

/** 兴趣四卡：bio.md 的探索 / 输入 / 创造 + 在玩的游戏 */
const interestCards = [
  ...interests.map((group) => ({
    name: group.label,
    desc: group.items.join(' · '),
    meta: group.en.toUpperCase(),
  })),
  {
    name: '在玩',
    desc: '正在玩的几款，链接都在。',
    meta: 'PLAYING',
  },
];
---

<BaseLayout
  title={titled('关于')}
  description="川崎·杭汐（Aonzik Kawasaki）：计算机人工智能专业本科在读，折腾个人服务器与私有云，也写点吴越方言与二次元，分享些料理、音乐与摄影。"
  active="about"
>
  <main>
    <div class="container">
      <div class="about-hero">
        <div>
          <p class="eyebrow">关于</p>
          <p class="about-lead" data-reveal>
            {lead.before}<br />{lead.after}<em>{lead.em}</em>。
          </p>

          <div class="about-body decor-host" data-reveal>
            {intro.map((paragraph) => <p>{paragraph}</p>)}
            <Decor slot="about-hero-figure" />
          </div>

          <p class="about-alias" data-reveal>{identity.aliasNote}。</p>

          <div class="contact-row" data-reveal>
            <a class="btn btn-primary" href={site.links.email} aria-label={`邮箱：${site.author.email}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></svg>
              <span class="email-obfuscated">{site.links.emailUser}</span>
            </a>
            <a class="btn btn-ghost" href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a class="btn btn-ghost" href={site.links.bilibili} target="_blank" rel="noopener noreferrer">Bilibili {identity.bilibili}</a>
            <a class="btn btn-ghost" href={site.links.rss}>RSS</a>
          </div>
        </div>

        <aside class="profile-card" data-reveal>
          <div class="profile-avatar decor-host" aria-hidden="true">
            {site.markLetter}
            <Decor slot="profile-avatar-frame" />
          </div>
          <p class="profile-name">{identity.zh}</p>
          <p class="profile-en">{identity.en}</p>
          <p class="profile-role">{site.author.role}</p>
          <dl class="profile-facts">
            {
              facts.map((fact) => (
                <div class="profile-fact">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
    </div>

    <section class="section section--tight">
      <div class="container">
        <div class="about-grid">
          <div>
            <div class="section-head decor-host">
              <h2>研究线索</h2>
              <span class="eyebrow">在推进的四件事</span>
              <Decor slot="section-ornament" />
            </div>
            <div class="timeline" data-reveal>
              {
                research.map((item) => (
                  <div class="timeline-item">
                    <span class="timeline-year">{item.no}</span>
                    <p class="timeline-title">{item.title}</p>
                    <p class="timeline-desc">{item.desc}</p>
                    <p class="timeline-meta">{item.meta}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <div>
            <div class="section-head decor-host">
              <h2>工具</h2>
              <span class="eyebrow">常用的</span>
              <Decor slot="section-ornament" />
            </div>
            <div class="tool-groups" data-reveal>
              {
                stack.map((group) => (
                  <div class="tool-group">
                    <p class="tool-label">
                      {group.label}
                      <span>{group.en}</span>
                    </p>
                    <ul class="tool-chips" role="list">
                      {group.items.map((item) =>
                        item.href ? (
                          <li>
                            <a class="chip chip--link" href={item.href} target="_blank" rel="noopener noreferrer">{item.name}</a>
                          </li>
                        ) : (
                          <li><span class="chip">{item.name}</span></li>
                        )
                      )}
                    </ul>
                  </div>
                ))
              }
            </div>

            <div class="section-head decor-host section-head--stacked">
              <h2>个人标签</h2>
              <Decor slot="section-ornament" />
            </div>
            <ul class="tag-list" role="list" data-reveal>
              {personalTags.map((tag) => <li><span class="chip">{tag}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <div class="section-head decor-host">
          <h2>兴趣</h2>
          <span class="eyebrow">不务正业的部分</span>
          <Decor slot="section-ornament" />
        </div>
        <div class="project-grid">
          {
            interestCards.map((card, index) => (
              <div class="project-card" data-reveal>
                <p class="project-name">{card.name}</p>
                <p class="project-desc">{card.desc}</p>
                {index === interestCards.length - 1 && (
                  <ul class="card-links" role="list">
                    {games.map((game) => (
                      <li>
                        <a href={game.href} target="_blank" rel="noopener noreferrer">
                          {game.name}
                          <span aria-hidden="true">↗</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="project-meta">{card.meta}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <Decor slot="content-divider" />
        <div class="author-card" data-reveal>
          <p class="eyebrow">保持联系</p>
          <p>想聊聊AI发展、二次元、吴越方言或者自建服务，都欢迎写信——Bilibili 也能找到我。</p>
          <a class="btn btn-primary" href={site.links.email} aria-label={`邮箱：${site.author.email}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
            <span class="email-obfuscated">{site.links.emailUser}</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
