---
/**
 * 站点页脚 —— 结构逐字复刻原稿（品牌 + 三列 + 底部版权/社交），
 * 分类列指向 /tags/<分类>/，联系列的 RSS 指向 /rss.xml。
 */
import Decor from './Decor.astro';
import { footerCategories, footerNav, site, copyrightLine } from '../lib/site';
import { tagPath } from '../lib/posts';

const copy = copyrightLine(new Date());
---

<footer class="site-footer decor-host">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="nav-brand" href="/" aria-label="Aonzik 首页">
          <span class="nav-brand-mark" aria-hidden="true">
            <svg viewBox="0 0 16 16"><path d="M3 12 L8 2 L13 12 M5.5 8 H10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
          </span>
          <span class="nav-brand-name">{site.name}</span>
        </a>
        <p class="footer-tagline">{site.footerTagline}</p>
      </div>

      <div>
        <p class="footer-col-title">导航</p>
        <ul class="footer-links" role="list">
          {footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>

      <div>
        <p class="footer-col-title">分类</p>
        <ul class="footer-links" role="list">
          {footerCategories.map((name) => <li><a href={tagPath(name)}>{name}</a></li>)}
        </ul>
      </div>

      <div>
        <p class="footer-col-title">联系</p>
        <ul class="footer-links" role="list">
          <li><a href={site.links.github}>GitHub</a></li>
          <li><a href={site.links.twitter}>Twitter / X</a></li>
          <li><a href={site.links.rss}>RSS 订阅</a></li>
          <li><a href={site.links.email}>邮件</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">{copy}</p>
      <div class="footer-social">
        <a href={site.links.github} aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" /></svg>
        </a>
        <a href={site.links.rss} aria-label="RSS">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" /></svg>
        </a>
      </div>
    </div>
  </div>

  <Decor slot="footer-mascot" />
  <Decor slot="footer-ground" class="decor-slot--flow" />
</footer>